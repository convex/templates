{
  "name": "tanstack-start-clerk",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node .output/server/index.mjs",
